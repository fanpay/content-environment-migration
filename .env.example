# Source environment (the one the custom app is installed in)
VITE_SOURCE_ENVIRONMENT_ID=your-source-env-id
VITE_SOURCE_MANAGEMENT_API_KEY=your-source-mapi-key

# Target environments as JSON array
# Each entry needs: name, environmentId, managementApiKey
VITE_TARGET_ENVIRONMENTS=[{"name":"QA","environmentId":"your-qa-env-id","managementApiKey":"your-qa-mapi-key"},{"name":"Production","environmentId":"your-prod-env-id","managementApiKey":"your-prod-mapi-key"}]
